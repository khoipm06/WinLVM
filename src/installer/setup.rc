#include <winver.h>

1 24 "installer.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WinLVM Project"
            VALUE "FileDescription", "WinLVM Setup"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "winlvm-setup-x64.exe"
            VALUE "OriginalFilename", "winlvm-setup-x64.exe"
            VALUE "ProductName", "WinLVM"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
