; winlvm.inf
;
; Bus driver INF: installs winlvm.sys on the root-enumerated bus devnode
; (ROOT\winlvm). Class=System — the bus is NOT a volume; a Volume-class bus
; makes the volume class filters (volsnap) attach to the bus stack.
; LV volume children are matched separately by winlvm-vol.inf.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderString%
DriverVer=09/11/2026,1.1.0.0
CatalogFile=winlvm.cat
PnpLockdown=1

[Manufacturer]
%ManufacturerString%=Standard,NTamd64

[Standard.NTamd64]
%WinLvmDeviceDesc%=WinLvm_Install,ROOT\winlvm

[WinLvm_Install.NT]
CopyFiles=WinLvm.Files

[WinLvm.Files]
winlvm.sys

[WinLvm_Install.NT.Services]
AddService=winlvm,0x00000002,WinLvm_Service_Inst

[WinLvm_Service_Inst]
DisplayName    = %WinLvmServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START (runtime install; early-boot probes deadlock)
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\winlvm.sys
LoadOrderGroup = System Bus Extender
AddReg         = WinLvm_AddReg

[WinLvm_AddReg]
; Any registry parameters live under the Parameters subkey so InfVerif is
; satisfied that they cannot be tampered with by arbitrary apps.
HKR,"Parameters","DebugFlags",0x00010001,0x0

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
winlvm.sys  = 1,,

[DestinationDirs]
DefaultDestDir = 12 ; Drivers directory

[Strings]
ProviderString = "winlvm"
ManufacturerString = "winlvm"
WinLvmDeviceDesc = "winlvm Logical Volume Manager Bus"
WinLvmServiceDesc = "winlvm Volume Manager Service"
DiskId1 = "winlvm Installation Disk"